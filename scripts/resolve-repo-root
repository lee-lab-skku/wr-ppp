#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH=${BASH_SOURCE[0]}
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(
        cd -P -- "$(dirname -- "$SCRIPT_PATH")"
        pwd -P
    )"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    if [[ $SCRIPT_PATH != /* ]]; then
        SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
    fi
done

SCRIPT_DIR="$(
    cd -P -- "$(dirname -- "$SCRIPT_PATH")"
    pwd -P
)"
REPO_DIR="$(
    cd -- "$SCRIPT_DIR/.."
    pwd -P
)"

for required_file in template.tex weekly-report.sty scripts/setup.sh; do
    if [[ ! -f "$REPO_DIR/$required_file" ]]; then
        echo "Template repository file not found: $REPO_DIR/$required_file" >&2
        exit 1
    fi
done

printf '%s\n' "$REPO_DIR"
