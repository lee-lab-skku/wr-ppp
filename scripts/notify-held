#!/usr/bin/env python3
"""Preview or explicitly send a missing-report hold notice through Slack."""

import argparse
import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from urllib.error import HTTPError, URLError
from urllib.request import HTTPRedirectHandler, Request, build_opener


# Resolve installed symlinks; frozen Windows imports use the bundled module.
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from admin_records import read_manifest


def data_directory():
    script = Path(__file__).resolve().parent / "admin-paths"
    result = subprocess.run([str(script), "--history-output"], check=True,
                            capture_output=True, text=True)
    return Path(result.stdout.strip()).parent


def validate_webhook(url):
    if not re.fullmatch(r"https://hooks\.slack(?:-gov)?\.com/services/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+", url):
        raise ValueError("Expected an HTTPS Slack Incoming Webhook URL; value omitted.")
    return url


def configure(directory):
    if not sys.stdin.isatty():
        raise ValueError("Run --configure in an interactive terminal for hidden input.")
    url = validate_webhook(getpass.getpass("Slack Incoming Webhook URL (hidden): ").strip())
    directory.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".slack-webhook-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(url + "\n")
        os.replace(temporary, directory / "slack-webhook.url")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print("Webhook saved. No message was sent.")


def notice(manifest):
    parsed = read_manifest(manifest)
    bundle = parsed.bundle
    if (bundle.state, bundle.approval) != ("draft", "required"):
        raise ValueError("Only a draft awaiting review can have a hold notice.")
    missing = sorted((entry for entry in parsed.entries
                      if entry.requirement == "required" and entry.state == "missing"),
                     key=lambda entry: (entry.order, entry.member_id))
    if not missing:
        raise ValueError("No required reports are missing; no hold notice is applicable.")
    text = (f"주간보고 취합 보류 · {bundle.week}\n"
            f"보고 기간: {bundle.start} ~ {bundle.end}\n"
            f"필수 제출 누락: {len(missing)}명\n"
            + "\n".join(f"• {r.display_name}" for r in missing)
            + "\n누락 보고서가 있어 관리자가 취합을 보류했습니다. 제출 후 관리자에게 알려 주세요.")
    if len(text) > 2900:
        raise ValueError("Notice is too long for one Slack section.")
    # Plain text avoids interpreting names as mentions or Slack markup.
    fallback = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    payload = {"text": fallback, "mrkdwn": False,
               "blocks": [{"type": "section", "text": {"type": "plain_text", "text": text}}],
               "unfurl_links": False, "unfurl_media": False}
    fingerprint = hashlib.sha256(json.dumps([bundle.week, sorted(r.member_id for r in missing)],
                                           ensure_ascii=False).encode()).hexdigest()
    return payload, fingerprint


ISSUE_TYPES = {
    "missing-report": ("필수 제출 누락", "해당 기간 보고서를 제출하고 관리자에게 알려 주세요."),
    "ambiguous-report": ("최종본 후보 모호", "해당 기간의 최종 제출본을 확인해 주세요."),
    "unreadable-pdf": ("PDF 손상·암호화·검사 불가", "읽고 검사할 수 있는 PDF를 확인해 주세요."),
    "overlength-report": ("2페이지 초과", "분량을 줄이거나 필수 내용 보존을 위한 예외 사유를 관리자와 확인해 주세요."),
    "internal-week-mismatch": ("내부 주차 불일치", "보고서의 주차 표기를 확인해 주세요."),
}


def review_notice(manifest, message=None):
    """Render only evidenced issues; agent prose never supplies identity or scope.

    The fingerprint binds approval and deduplication to the rendered message and
    its issue identities, excluding private evidence and record ordering.
    """
    parsed = read_manifest(manifest)
    bundle = parsed.bundle
    if (bundle.state, bundle.approval) != ("draft", "required"):
        raise ValueError("Only a draft awaiting review can have an issue notice.")
    members = {entry.member_id: entry for entry in parsed.entries}
    problems = {(entry.member_id, "missing-report") for entry in parsed.entries
                if entry.requirement == "required" and entry.state == "missing"}
    for record in parsed.records:
        if type(record).__name__ != "Issue" or record.code not in ISSUE_TYPES:
            continue
        if record.member_id not in members:
            raise ValueError("Notification issue references an unknown member.")
        entry = members[record.member_id]
        if record.code == "missing-report":
            if (entry.requirement, entry.state) != ("required", "missing"):
                raise ValueError("Missing-report issue does not match required missing state.")
        else:
            if record.code == "overlength-report" and entry.page_count <= 2:
                raise ValueError("Overlength issue requires a selected report longer than two pages.")
            problems.add((entry.member_id, record.code))
    if not problems:
        raise ValueError("No supported review issues; no issue notice is applicable.")

    introduction = "검토 중 다음 문제가 확인되었습니다."
    closing = "요청 사항을 확인하고 관리자에게 알려 주세요."
    prose = {key: ("", ISSUE_TYPES[key[1]][1]) for key in problems}
    if message is not None:
        try:
            proposal = json.loads(Path(message).read_text(encoding="utf-8"))
        except (ValueError, OSError):
            raise ValueError("Unable to read message JSON; content omitted.") from None
        if not isinstance(proposal, dict) or set(proposal) != {"introduction", "closing", "items"}:
            raise ValueError("Message requires introduction, closing, and items only.")
        introduction, closing = proposal["introduction"], proposal["closing"]
        if not isinstance(proposal["items"], list):
            raise ValueError("Message items must be a list.")
        prose = {}
        for item in proposal["items"]:
            if not isinstance(item, dict) or set(item) != {"member_id", "code", "description", "action"}:
                raise ValueError("Each message item requires member_id, code, description, and action.")
            if not all(isinstance(item[k], str) for k in item):
                raise ValueError("Message item fields must be strings.")
            key = (item["member_id"], item["code"])
            if key not in problems or key in prose:
                raise ValueError("Message items must match evidenced problems exactly, without duplicates.")
            prose[key] = (item["description"], item["action"])
        if set(prose) != problems:
            raise ValueError("Message must cover every notification problem.")
    for value in [introduction, closing] + [v for pair in prose.values() for v in pair]:
        if not isinstance(value, str) or any(ord(c) < 32 and c != "\n" for c in value):
            raise ValueError("Message prose must be text without control characters.")
        if "hooks.slack" in value or re.search(r"(?:https?://|file://|(?:^|\s)/|[A-Za-z]:[\\/]|\\\\|~/)", value):
            raise ValueError("Message prose must not contain URLs or local paths.")
    if any(not action.strip() for _, action in prose.values()):
        raise ValueError("Every problem requires an action.")

    sections = [f"주간보고 검토 중 확인된 문제 · {bundle.week}\n보고 기간: {bundle.start} ~ {bundle.end}"]
    if introduction.strip():
        sections.append(introduction)
    for entry in sorted(parsed.entries, key=lambda e: (e.order, e.member_id)):
        lines = []
        for code in ISSUE_TYPES:
            key = (entry.member_id, code)
            if key not in problems:
                continue
            label = ISSUE_TYPES[code][0]
            if code == "overlength-report":
                label += f" ({entry.page_count}페이지)"
            description, action = prose[key]
            lines.append(f"• {label}" + (f": {description}" if description.strip() else "") + f"\n  요청: {action}")
        if lines:
            sections.append(entry.display_name + "\n" + "\n".join(lines))
    if closing.strip():
        sections.append(closing)
    if len(sections) > 50 or any(len(section) > 2900 for section in sections):
        raise ValueError("Notice exceeds Slack block limits; shorten prose without omitting problems.")
    text = "\n\n".join(sections)
    if len(text) > 39000:
        raise ValueError("Notice exceeds Slack total length; shorten prose without omitting problems.")
    fallback = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    if len(fallback) > 39000:
        raise ValueError("Notice fallback exceeds Slack total length; shorten prose without omitting problems.")
    payload = {"text": fallback, "mrkdwn": False,
               "blocks": [{"type": "section", "text": {"type": "plain_text", "text": s}} for s in sections],
               "unfurl_links": False, "unfurl_media": False}
    fingerprint = hashlib.sha256(json.dumps([bundle.week, sorted(problems), payload],
                                           ensure_ascii=False, sort_keys=True).encode()).hexdigest()
    return payload, fingerprint


def review_options(parser):
    parser.add_argument("--configure", action="store_true", help="save a webhook using hidden input")
    parser.add_argument("--manifest", type=Path, help="draft execution TSV")
    parser.add_argument("--message", type=Path, help="agent-authored message JSON")
    parser.add_argument("--approved", help="fingerprint of the exact preview approved by the administrator")
    parser.add_argument("--send", action="store_true", help="send approved preview to the authorized channel")


def review_command(args, directory):
    """Shared CLI workflow. Actual human approval remains the agent's responsibility."""
    if args.configure:
        if args.manifest or args.message or args.approved or args.send:
            raise ValueError("--configure cannot be combined with notice options")
        configure(directory)
        return
    if not args.manifest:
        raise ValueError("--manifest is required")
    payload, fingerprint = review_notice(args.manifest, args.message)
    if args.send:
        if args.approved != fingerprint:
            raise ValueError("--send requires --approved with the unchanged preview fingerprint and administrator approval.")
        send(directory, payload, fingerprint)
    else:
        print(json.dumps({"payload": payload, "approval": fingerprint}, ensure_ascii=False, indent=2))


def issues_main():
    parser = argparse.ArgumentParser(description="Preview or send administrator-approved review issue notices.")
    review_options(parser)
    args = parser.parse_args()
    try:
        # Preview requires neither configuration nor a webhook lookup.
        directory = data_directory() if args.configure or args.send else None
        review_command(args, directory)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(str(error) if isinstance(error, ValueError) else "Unable to access notification configuration or records.", file=sys.stderr)
        return 1
    return 0


class NoRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def post(url, payload):
    request = Request(url, data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
                      headers={"Content-Type": "application/json; charset=utf-8"}, method="POST")
    try:
        with build_opener(NoRedirect()).open(request, timeout=15) as response:
            if response.status != 200 or response.read(128).strip() != b"ok":
                raise ValueError("Slack did not confirm delivery; check the channel before retrying.")
    except HTTPError as error:
        raise ValueError(f"Slack HTTP {error.code}; no automatic retry was attempted.") from None
    except (URLError, TimeoutError, OSError):
        raise ValueError("Delivery could not be confirmed; check Slack before retrying. URL omitted.") from None


def send(directory, payload, fingerprint):
    url_file = directory / "slack-webhook.url"
    if not url_file.is_file():
        raise ValueError("Webhook is not configured. Run scripts/notify-held --configure first.")
    url = validate_webhook(url_file.read_text(encoding="utf-8").strip())
    # Bind receipts to the destination without storing its secret URL.
    key = fingerprint + "-" + hashlib.sha256(url.encode()).hexdigest()[:16]
    receipts = directory / "notifications"
    receipts.mkdir(parents=True, exist_ok=True)
    receipt = receipts / (key + ".sent")
    lock = receipts / (key + ".lock")
    if receipt.exists():
        print("Already notified for this message and webhook.")
        return
    try:
        lock.mkdir()
    except FileExistsError:
        raise ValueError(f"Notice is already sending or awaiting delivery review; check Slack before removing {lock}.") from None
    if receipt.exists():
        lock.rmdir()
        print("Already notified for this message and webhook.")
        return
    # Keep the lock on an uncertain delivery, avoiding an accidental duplicate.
    post(url, payload)
    receipt.write_text("sent\n", encoding="utf-8")
    lock.rmdir()
    print("Slack notice sent.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--configure", action="store_true", help="save a webhook using hidden terminal input")
    parser.add_argument("--manifest", type=Path, help="draft execution TSV")
    parser.add_argument("--held", action="store_true", help="administrator has decided to hold for missing reports")
    parser.add_argument("--send", action="store_true", help="send to Slack; otherwise preview only")
    args = parser.parse_args()
    try:
        if args.configure:
            if args.manifest or args.held or args.send:
                parser.error("--configure cannot be combined with notice options")
            configure(data_directory())
            return 0
        if not args.manifest:
            parser.error("--manifest is required")
        if args.send and not args.held:
            parser.error("--send requires --held and an actual administrator hold decision")
        payload, fingerprint = notice(args.manifest)
        if not args.send:
            print(json.dumps(payload, ensure_ascii=False, indent=2))
            return 0
        send(data_directory(), payload, fingerprint)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(str(error) if isinstance(error, ValueError) else "Unable to access notification configuration or records.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
