#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 /absolute/path/to/bundle.pdf" >&2
    echo "Open a bundle in the user's default PDF viewer (Linux, macOS, or WSL)." >&2
}

die() {
    echo "$1" >&2
    exit "${2:-1}"
}

if [[ $# -eq 1 && ( $1 == --help || $1 == -h ) ]]; then
    usage
    exit 0
elif [[ $# -ne 1 ]]; then
    usage
    exit 2
fi

PDF_PATH=$1
[[ $PDF_PATH == /* ]] || die "Bundle path must be absolute: $PDF_PATH" 2
[[ -f $PDF_PATH && -s $PDF_PATH ]] || die "Bundle PDF not found or empty: $PDF_PATH" 2
case $PDF_PATH in
    *.[Pp][Dd][Ff]) ;;
    *) die "Bundle file does not have a PDF extension: $PDF_PATH" 2 ;;
esac
PDF_DIR="$(cd -P -- "$(dirname -- "$PDF_PATH")" && pwd -P)"
PDF_PATH="$PDF_DIR/$(basename -- "$PDF_PATH")"
printf 'review PDF: %s\n' "$PDF_PATH" >&2

HOST_SYSTEM="$(uname -s)"
HOST_RELEASE="$(uname -r)"
if [[ $HOST_SYSTEM == Darwin ]]; then
    open "$PDF_PATH" || die "Unable to open the bundle in the macOS PDF viewer."
elif [[ -n ${WSL_INTEROP:-} || -n ${WSL_DISTRO_NAME:-} ||
    $HOST_RELEASE == *[Mm]icrosoft* ]]
then
    if command -v wslview >/dev/null 2>&1; then
        wslview "$PDF_PATH" || die "Unable to open the bundle with wslview."
    elif command -v wslpath >/dev/null 2>&1 &&
        command -v powershell.exe >/dev/null 2>&1
    then
        WINDOWS_PATH="$(wslpath -w "$PDF_PATH")"
        [[ -n $WINDOWS_PATH ]] || die "Unable to resolve the bundle's Windows path."
        printf 'Windows review path: %s\n' "$WINDOWS_PATH" >&2
        # PowerShell single-quoted strings escape apostrophes by doubling them.
        POWERSHELL_PATH=${WINDOWS_PATH//\'/\'\'}
        powershell.exe -NoProfile -NonInteractive -Command \
            "\$ErrorActionPreference = 'Stop'; Start-Process -FilePath '$POWERSHELL_PATH'" ||
            die "Unable to open the bundle in the Windows PDF viewer."
    else
        die "No WSL PDF opener is available. Open the review PDF path in a desktop viewer; automatic opening needs wslview or wslpath with powershell.exe."
    fi
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$PDF_PATH" || die "Unable to open the bundle in the Linux PDF viewer."
else
    die "No desktop PDF opener is available. Open the review PDF path in a desktop viewer; automatic opening on Linux needs xdg-open."
fi
