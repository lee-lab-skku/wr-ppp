% =========================================================
% General formatting
% =========================================================
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\renewcommand{\arraystretch}{1.20}
\setlist[itemize]{
    leftmargin=5mm,
    itemsep=1mm,
    topsep=1mm
}
\setlist[itemize,2]{
    label=\(\circ\)
}
\setlist[enumerate]{
    leftmargin=6mm,
    itemsep=1mm,
    topsep=1mm
}

\definecolor{mainblue}{RGB}{38,70,110}
\definecolor{lightblue}{RGB}{238,244,250}
\definecolor{lightgray}{RGB}{246,246,246}
\definecolor{linegray}{RGB}{190,190,190}

\hypersetup{
    colorlinks=true,
    linkcolor=mainblue,
    urlcolor=mainblue
}

\newcommand{\ReportTitle}{}

% =========================================================
% Report header
% Arguments: report title, author name, project/team.
% =========================================================
\newcommand{\ReportHeader}[3]{%
    \gdef\ReportTitle{#1}%
    \begin{center}
        {\LARGE\bfseries #1}\\[1mm]
        {\small Weekly Report \#\ReportSerialNumber}
    \end{center}

    \vspace{2mm}

    \begin{tabularx}{\textwidth}{
        >{\bfseries}l X
        >{\bfseries}l X
        >{\bfseries}l l
    }
        Name
            & #2
            & Project
            & #3
            & Reporting Week
            & \ReportWeekLabel
            \\
    \end{tabularx}

    \vspace{3mm}
}

% =========================================================
% Table helpers
% L, C, and R are wrapping, flexible-width columns. Standard tabularx column
% types such as l, c, r, and p{<width>} may also be used in a column layout.
% =========================================================
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}

% Arguments: column layout, table rows, caption, unique label.
\newcommand{\ReportTable}[4]{%
    \begin{table}[H]
        \centering
        \small
        \caption{#3}
        \label{#4}
        \begin{tabularx}{0.96\linewidth}{
            #1
        }
            #2
        \end{tabularx}
    \end{table}
}

% =========================================================
% Figure helpers
% =========================================================

% Internal helper: image or fixed-size placeholder.
% Arguments: file path, display width, display height.
\newcommand{\ReportImageOrPlaceholder}[3]{%
    \parbox[c][#3][c]{#2}{%
        \centering
        \IfFileExists{#1}
        {%
            \includegraphics[
                width=\linewidth,
                height=#3,
                keepaspectratio
            ]{#1}%
        }
        {%
            \fbox{%
                \parbox[c][
                    \dimexpr#3-2\fboxsep-2\fboxrule\relax
                ][c]{
                    \dimexpr\linewidth-2\fboxsep-2\fboxrule\relax
                }{%
                    \centering
                    \small
                    \textbf{Figure Placeholder}\\[2mm]
                    Add the image at\\
                    \path{#1}%
                }%
            }%
        }%
    }%
}

% Arguments: file path, caption, unique label, height.
\newcommand{\ReportFigure}[4]{%
    \begin{figure}[H]
        \centering
        \ReportImageOrPlaceholder{#1}{\linewidth}{#4}
        \caption{#2}
        \label{#3}
    \end{figure}
}

% Arguments: left path/caption/label, then right path/caption/label.
% These are independent figures, each with its own number.
\newcommand{\ReportFigurePair}[6]{%
    \begin{figure}[H]
        \centering
        \begin{minipage}[t]{0.48\linewidth}
            \centering
            \ReportImageOrPlaceholder{#1}{\linewidth}{35mm}
            \caption{#2}
            \label{#3}
        \end{minipage}%
        \hfill
        \begin{minipage}[t]{0.48\linewidth}
            \centering
            \ReportImageOrPlaceholder{#4}{\linewidth}{35mm}
            \caption{#5}
            \label{#6}
        \end{minipage}
    \end{figure}
}

% =========================================================
% Content boxes
% =========================================================
\newcounter{reportbox}
\newcounter{reportsubsection}[reportbox]
\renewcommand{\theHreportsubsection}{%
    \arabic{reportbox}.\arabic{reportsubsection}%
}
\newlength{\ReportSubsectionBeforeSkip}
\newlength{\ReportSubsectionAfterSkip}
\setlength{\ReportSubsectionBeforeSkip}{2mm}
\setlength{\ReportSubsectionAfterSkip}{0.5mm}

\newcommand{\ReportSubsection}[1]{%
    \par
    \ifnum\value{reportsubsection}>0
        \addvspace{\ReportSubsectionBeforeSkip}%
    \fi
    \refstepcounter{reportsubsection}%
    \noindent{\bfseries\large\thereportsubsection. #1}\par
    \nobreak\vspace{\ReportSubsectionAfterSkip}%
}

\newtcolorbox{reportabstract}{
    colback=lightblue,
    colframe=mainblue,
    boxrule=0.6pt,
    arc=1mm,
    title={Abstract},
    fonttitle=\bfseries,
    colbacktitle=mainblue
}

\newtcolorbox{pppbox}[1]{
    enhanced,
    breakable,
    colback=white,
    colframe=mainblue,
    boxrule=0.8pt,
    arc=1.5mm,
    left=3mm,
    right=3mm,
    top=2mm,
    bottom=2mm,
    title={#1},
    fonttitle=\bfseries\large,
    coltitle=white,
    colbacktitle=mainblue,
    before upper={\stepcounter{reportbox}}
}

