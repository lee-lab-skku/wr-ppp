% =========================================================
% General formatting
% =========================================================
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\renewcommand{\arraystretch}{1.20}
\setlist[itemize]{
    leftmargin=5mm,
    itemsep=1mm,
    topsep=1mm
}
\setlist[itemize,2]{
    label=\(\circ\)
}
\setlist[enumerate]{
    leftmargin=6mm,
    itemsep=1mm,
    topsep=1mm
}

\definecolor{mainblue}{RGB}{38,70,110}
\definecolor{lightblue}{RGB}{238,244,250}
\definecolor{lightgray}{RGB}{246,246,246}
\definecolor{linegray}{RGB}{190,190,190}

\hypersetup{
    colorlinks=true,
    linkcolor=mainblue,
    urlcolor=mainblue
}

% =========================================================
% Automatic reporting week
%
% Weeks run Monday--Sunday and belong to the month containing
% Thursday, equivalent to a four-day majority rule.
% =========================================================
\newcount\ReportDateJulian
\newcount\WeekdayIndex
\newcount\ReportWeekNumber

\pgfcalendardatetojulian
    {\the\year-\the\month-\the\day}
    {\ReportDateJulian}

\pgfcalendarjuliantoweekday
    {\ReportDateJulian}
    {\WeekdayIndex}

% Move from the compilation date to Thursday.
\advance\ReportDateJulian by 3
\advance\ReportDateJulian by -\WeekdayIndex

\pgfcalendarjuliantodate
    {\ReportDateJulian}
    {\ReportYear}
    {\ReportMonth}
    {\ReportThursdayDay}

% Thursday 1--7 is W1, 8--14 is W2, and so on.
\ReportWeekNumber=\ReportThursdayDay
\advance\ReportWeekNumber by -1
\divide\ReportWeekNumber by 7
\advance\ReportWeekNumber by 1

\newcommand{\TwoDigits}[1]{%
    \ifnum\numexpr#1\relax<10 0\fi
    \number\numexpr#1\relax
}

\newcommand{\ReportWeekLabel}{%
    \ReportYear-\TwoDigits{\ReportMonth}-W\the\ReportWeekNumber%
}

% =========================================================
% Report header
% Arguments: report title, author name, project/team.
% =========================================================
\newcommand{\ReportHeader}[3]{%
    \begin{center}
        {\LARGE\bfseries #1}\\[1mm]
        {\small Weekly Report}
    \end{center}

    \vspace{2mm}

    \begin{tabularx}{\textwidth}{
        >{\bfseries}l X
        >{\bfseries}l X
        >{\bfseries}l l
    }
        Name
            & #2
            & Project
            & #3
            & Reporting Week
            & \ReportWeekLabel
            \\
    \end{tabularx}

    \vspace{3mm}
}

% =========================================================
% Table helpers
% Arguments: table rows, caption, unique label.
% =========================================================
\newcommand{\ReportResultsTable}[3]{%
    \begin{table}[H]
        \centering
        \small
        \begin{tabularx}{0.95\linewidth}{
            l
            >{\centering\arraybackslash}X
            >{\centering\arraybackslash}X
            >{\centering\arraybackslash}X
        }
            #1
        \end{tabularx}
        \caption{#2}
        \label{#3}
    \end{table}
}

\newcommand{\ReportPlanTable}[3]{%
    \begin{table}[H]
        \centering
        \small
        \begin{tabularx}{0.96\linewidth}{
            >{\centering\arraybackslash}p{18mm}
            X
            >{\centering\arraybackslash}p{31mm}
        }
            #1
        \end{tabularx}
        \caption{#2}
        \label{#3}
    \end{table}
}

% =========================================================
% Figure helpers
% =========================================================

% Internal helper: image or fixed-size placeholder.
% Arguments: file path, display width, display height.
\newcommand{\ReportImageOrPlaceholder}[3]{%
    \parbox[c][#3][c]{#2}{%
        \centering
        \IfFileExists{#1}
        {%
            \includegraphics[
                width=\linewidth,
                height=#3,
                keepaspectratio
            ]{#1}%
        }
        {%
            \fbox{%
                \parbox[c][
                    \dimexpr#3-2\fboxsep-2\fboxrule\relax
                ][c]{
                    \dimexpr\linewidth-2\fboxsep-2\fboxrule\relax
                }{%
                    \centering
                    \small
                    \textbf{Figure Placeholder}\\[2mm]
                    Add the image at\\
                    \path{#1}%
                }%
            }%
        }%
    }%
}

% Arguments: file path, caption, unique label, height.
\newcommand{\ReportFigure}[4]{%
    \begin{figure}[H]
        \centering
        \ReportImageOrPlaceholder{#1}{\linewidth}{#4}
        \caption{#2}
        \label{#3}
    \end{figure}
}

% Arguments: left path/caption/label, then right path/caption/label.
% These are independent figures, each with its own number.
\newcommand{\ReportFigurePair}[6]{%
    \begin{figure}[H]
        \centering
        \begin{minipage}[t]{0.48\linewidth}
            \centering
            \ReportImageOrPlaceholder{#1}{\linewidth}{35mm}
            \caption{#2}
            \label{#3}
        \end{minipage}%
        \hfill
        \begin{minipage}[t]{0.48\linewidth}
            \centering
            \ReportImageOrPlaceholder{#4}{\linewidth}{35mm}
            \caption{#5}
            \label{#6}
        \end{minipage}
    \end{figure}
}

